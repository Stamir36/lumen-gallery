{
  "name": "lumen",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first photo & video gallery for Windows — Tauri v2 + React + Rust",
  "license": "GPL-3.0-or-later",
  "author": "Stanislav Miroshnichenko (Unesell Studio)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stamir36/lumen-gallery.git"
  },
  "homepage": "https://stamir36.github.io/lumen-gallery/",
  "bugs": {
    "url": "https://github.com/Stamir36/lumen-gallery/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "photo-gallery",
    "video-player",
    "image-viewer",
    "tauri",
    "rust",
    "react",
    "windows",
    "desktop-app",
    "local-first",
    "media-organizer"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "site": "python -m http.server 4173 --directory site",
    "build:store": "tauri build --no-bundle && tauri bundle --config src-tauri/tauri.microsoftstore.conf.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-menu": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.12.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
