<?xml version="1.0" encoding="utf-8"?>
<!--
  LUMEN — MSIX package manifest (Microsoft Store).

  This manifest is the packaged twin of the EXE/NSIS installer: Windows installs
  it, the Store signs it for free and hosts it, so there is no code-signing
  certificate to buy and no download URL to keep alive.

  BEFORE SUBMITTING, replace the two identity values with the ones Partner Center
  shows under Product identity. They must match exactly or certification fails
  with an unhelpful error:

    Identity@Name       ← Package/Identity/Name       e.g. 12345Stamir36.LUMENGallery
    Identity@Publisher  ← Package/Identity/Publisher  e.g. CN=A1B2C3D4-...

  Identity@Version is rewritten from package.json by scripts/build-msix.ps1 at
  stage time; never edit it by hand.

  Two deliberate choices worth knowing about:

  * RuntimeBehavior=packagedClassicApp + TrustLevel=mediumIL is the standard
    desktop-app package: full trust, no app container.
  * The file type associations are declared here rather than registered at
    runtime. A packaged app's writes to HKEY_CURRENT_USER are virtualized into a
    per-package hive that Explorer cannot see, so src-tauri/src/assoc.rs cannot
    reach the real registry from inside the package — the package has to declare
    the handlers instead. Nothing is taken by default either way: declaring a
    handler only puts LUMEN into "Open with".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="Stamir36.LUMENGallery"
    Publisher="CN=EDIT-ME-PARTNER-CENTER-PUBLISHER"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LUMEN</DisplayName>
    <PublisherDisplayName>Stanislav Miroshnichenko</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A local-first photo and video gallery for Windows</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <!-- lumen.exe is the whole application: the frontend is compiled in. -->
    <Application
      Id="LUMEN"
      Executable="lumen.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">

      <uap:VisualElements
        DisplayName="LUMEN"
        Description="A local-first photo and video gallery for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Mirrors assoc.rs EXTENSIONS: the media LUMEN can open. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="lumen-media">
            <uap:DisplayName>LUMEN media</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required by every packaged desktop app. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
